  "compatibility_rules": [
    {
      "id": "knit-needs-flexible-platform",
      "when": {"upper": "engineered_knit"},
      "disallow": {"midsole": ["cork_latex"], "outsole": ["tpu"]},
      "reason": "Engineered knit uppers are built on flexible platforms; cork latex and TPU plates are too stiff for the pattern."
    },
    {
      "id": "cork-latex-casual-only",
      "when": {"midsole": "cork_latex"},
      "disallow": {"outsole": ["blown_rubber"]},
      "reason": "Cork latex midsoles are bonded to solid outsoles only."
    }
  ]
