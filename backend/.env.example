# Copy to backend/.env and adjust. Every key maps to app/config.py.
SOLEMATE_DATA_DIR=./data_store
# SOLEMATE_DATABASE_URL=postgresql+psycopg://user:pass@localhost/solemate
SOLEMATE_CORS_ORIGINS=["http://localhost:5173"]
SOLEMATE_SYNC_PROCESSING=false
SOLEMATE_VOXEL_RESOLUTION=128
SOLEMATE_CAMERA_HFOV_DEG=65
SOLEMATE_PAPER_SIZE=A4

# --- Preorders and payments (see docs/PAYMENTS.md) ---
SOLEMATE_PUBLIC_URL=http://localhost:5173
SOLEMATE_STRIPE_SECRET_KEY=            # sk_test_... while testing, sk_live_... when you launch
SOLEMATE_STRIPE_WEBHOOK_SECRET=        # whsec_... from `stripe listen` or the dashboard webhook
SOLEMATE_PREORDER_SHIP_ESTIMATE="Estimated shipping: to be announced. We will email you before production starts."
SOLEMATE_SHIPPING_POLICY="Shipping and any taxes or duties are not included in the price shown. We will contact you about them before production starts."

# --- Who you are, shown on the Privacy Policy and Preorder Terms ---
SOLEMATE_COMPANY_NAME=
SOLEMATE_SUPPORT_EMAIL=
SOLEMATE_COMPANY_ADDRESS=
SOLEMATE_GOVERNING_LAW=               # e.g. "the laws of the Republic of Korea"

# --- Retention (hours) ---
SOLEMATE_STALE_SESSION_HOURS=24
SOLEMATE_UNPAID_ORDER_HOURS=48
